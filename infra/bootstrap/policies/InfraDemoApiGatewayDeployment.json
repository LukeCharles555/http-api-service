{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageRegionalApis",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:eu-west-1::/apis",
        "arn:aws:apigateway:eu-west-1::/apis/*",
        "arn:aws:apigateway:eu-west-1::/tags/*"
      ]
    },
    {
      "Sid": "ManageDevLambdaInvocationPolicy",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy"
      ],
      "Resource": "arn:aws:lambda:eu-west-1:258562790897:function:infra-demo-api-dev"
    }
  ]
}
