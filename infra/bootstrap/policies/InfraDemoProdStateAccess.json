{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProdState",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::luke-infra-demo-tfstate-258562790897",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "prod/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteProdState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::luke-infra-demo-tfstate-258562790897/prod/terraform.tfstate"
    },
    {
      "Sid": "ManageProdStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::luke-infra-demo-tfstate-258562790897/prod/terraform.tfstate.tflock"
    }
  ]
}
